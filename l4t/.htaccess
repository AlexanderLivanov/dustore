RewriteEngine On

# ─────────────────────────────────────────────────────────────────────────────
# 1. Точечные файлы наружу не отдаём.
#
# Было: единственным правилом стоял rewrite профиля с условием
#   RewriteCond %{REQUEST_FILENAME} !-f
# .env — существующий файл, значит условие ложно, rewrite не применяется,
# и Apache отдаёт его как обычный текст. Встроенная защита Apache закрывает
# только ^\.ht — на .env она не распространяется.
#
# Правило ниже сделано именно RewriteRule, а не <Files>: <Files> с Require
# требует AllowOverride AuthConfig, а mod_rewrite обходится FileInfo, который
# и так нужен для остальных правил. Меньше шансов словить 500 на проде.
# ─────────────────────────────────────────────────────────────────────────────
RewriteRule (^|/)\. - [F,L]

# ─────────────────────────────────────────────────────────────────────────────
# 2. Служебные каталоги не должны попадать под правило профилей.
#    Если папку когда-нибудь переименуют или удалят, запрос к ней
#    не превратится молча в поиск пользователя с таким ником.
# ─────────────────────────────────────────────────────────────────────────────
RewriteRule ^(core|api|css|js|img|uploads)(/|$) - [L]

# ─────────────────────────────────────────────────────────────────────────────
# 3. /l4t/<username> -> профиль.
#
# Шаблон сужен с ^([^/]+)$ до явного набора символов: раньше под правило
# попадало вообще всё, включая строки с %00, кавычками и точками, и уезжало
# в SQL-параметр. Запрос параметризован, но пропускать в него мусор незачем.
# ─────────────────────────────────────────────────────────────────────────────
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([A-Za-z0-9_.@-]{1,64})/?$ index.php?username=$1 [L,QSA]
